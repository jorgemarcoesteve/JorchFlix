# =============================================================================
# JorchFlix - Variables de entorno
# Copiar este archivo a .env y rellenar solo con los valores marcados como
# OBLIGATORIO. El resto se configura desde el panel admin > Configuracion.
# ⚠ NUNCA subir .env a git.
# =============================================================================

# ---- Backend ----
PORT=3001
JWT_SECRET=                          # OBLIGATORIO: genera con "node -e "console.log(require('crypto').randomBytes(32).toString('hex'))""

# ---- Jellyfin ----
JELLYFIN_URL=                        # OBLIGATORIO: http://ip:8096
JELLYFIN_API_KEY=                    # OBLIGATORIO: API Key de Jellyfin

# ---- Radarr (solo URL y API Key, el resto va en admin panel) ----
RADARR_URL=
RADARR_API_KEY=

# ---- Sonarr (solo URL y API Key, el resto va en admin panel) ----
SONARR_URL=
SONARR_API_KEY=

# ---- TMDB ----
TMDB_API_KEY=                        # OBLIGATORIO: clave de themoviedb.org
